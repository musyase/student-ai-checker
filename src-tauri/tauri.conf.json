{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Student AI Checker",
  "version": "0.1.0",
  "identifier": "ru.student-ai-checker.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Student AI Checker",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "category": "Education",
    "shortDescription": "Локальная проверка студенческих работ",
    "longDescription": "Локальное рабочее место преподавателя для проверки DOCX через Ollama.",
    "externalBin": ["binaries/student-ai-checker-backend"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
